# The environment the crosstalk binary reads. Copy to .env (git-ignored,
# never committed) and fill in; scripts/try-claude-code.sh generates one
# under its run directory when none is given. deploy/run.sh init does the
# same for the compose deployment.

# Postgres, read when the config has a `store` section (crosstalk migrate,
# and /readyz under crosstalk serve). Carries the password: a secret.
DATABASE_URL=

# The deployment secret that keys every credential and account digest,
# named by ingress.secrets.current.env: 32 random bytes as 64 hex digits
# (openssl rand -hex 32). Keep it stable; rotate through
# ingress.secrets.previous.
CROSSTALK_SECRET_V1=

# The operator API's bearer token, named by api.token.env (the API itself
# is roadmap P7.1).
CROSSTALK_API_TOKEN=

# The embeddings endpoint's key, named by embeddings.api_key.env; may be
# empty for a keyless local endpoint.
CROSSTALK_EMBEDDINGS_API_KEY=

# tracing filter. Logs are JSON on stdout, one object per line.
RUST_LOG=info
