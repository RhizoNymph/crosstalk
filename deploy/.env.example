# Copy to deploy/.env (or run `bash deploy/run.sh init`, which generates the
# secrets). deploy/.env is git-ignored; never commit it.

# --- secrets -------------------------------------------------------------
POSTGRES_PASSWORD=
# Read-only role postgres-exporter connects as.
POSTGRES_MONITOR_PASSWORD=
# 64 hex digits; keys credential and account digests (ingress secrets.current).
CROSSTALK_SECRET_V1=
# Bearer token for the operator API.
CROSSTALK_API_TOKEN=
# Key for the OpenAI-compatible embeddings endpoint in config/crosstalk.json.
CROSSTALK_EMBEDDINGS_API_KEY=
GRAFANA_ADMIN_PASSWORD=

# --- ports and binds (defaults shown) -------------------------------------
# The proxy is the one listener agents on other machines need.
# CROSSTALK_PROXY_BIND=0.0.0.0
# CROSSTALK_PROXY_PORT=8080
# CROSSTALK_API_PORT=8081
# CROSSTALK_OPS_PORT=9464
# CROSSTALK_UI_PORT=3000
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# ALLOY_PORT=12345
# POSTGRES_PORT=5432
# NODE_EXPORTER_LISTEN=0.0.0.0:9100

# --- host ------------------------------------------------------------------
# Docker's data root, from `docker info --format '{{.DockerRootDir}}'`.
# snap Docker: /var/snap/docker/common/var-lib-docker
# DOCKER_ROOT_DIR=/var/lib/docker

# --- tuning (defaults suit a 16 GB machine) -------------------------------
# CROSSTALK_LOG=info
# PG_MAX_CONNECTIONS=200
# PG_SHARED_BUFFERS=2GB
# PG_EFFECTIVE_CACHE_SIZE=6GB
# PG_WORK_MEM=16MB
# PG_MAINTENANCE_WORK_MEM=1GB
# PROMETHEUS_RETENTION=15d
# PROMETHEUS_RETENTION_SIZE=10GB
